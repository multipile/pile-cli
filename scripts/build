#!/bin/sh
# Build bin/pile from the working tree, stamped with the commit and the date.
# Run it from the root, under mise. mise puts bin/ first on PATH.
#
# On Linux the binary is linked statically against musl, so it links no libc
# and runs the same outside the toolchain that built it. cargo-zigbuild links
# it with the zig that mise pins. On macOS it is the host's own build.
set -eu
PILE_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
PILE_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
export PILE_COMMIT PILE_DATE
host=$(rustc -vV | sed -n 's/^host: //p')
case $host in
  *-linux-gnu) target=${host%-gnu}-musl ;;
  *) target=$host ;;
esac
cargo zigbuild --release --locked -p pile --target "$target"
mkdir -p bin
# Written beside the old binary and then renamed over it, because the old
# binary may be the one running this.
cp "target/$target/release/pile" bin/pile.new
mv bin/pile.new bin/pile
