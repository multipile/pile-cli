#!/bin/sh
# zig as the C compiler and linker for this machine's own Rust builds. So the
# tests, the build scripts and an ordinary cargo build link with the zig that
# flake.nix pins, not with whatever cc the machine has, or none. The flake's
# shell names this script for Linux targets only, because macOS links with
# its own.
# Releases do not come through here: scripts/cross uses cargo-zigbuild, which
# wraps zig the same way for each target.
#
# rustc passes a flag that zig's linker does not know, so it is dropped.
for arg; do
  shift
  case $arg in
    -Wl,--fix-cortex-a53-843419) ;;
    *) set -- "$@" "$arg" ;;
  esac
done
exec zig cc "$@"
